  "description": "LifePilot AI Monorepo root scripts",
  "scripts": {
    "test:tasks": "npm --prefix backend run test:tasks",
    "test:task": "npm --prefix backend run test:tasks",
    "test:auth": "npm --prefix backend run test:auth",
    "test:ai": "npm --prefix backend run test:ai",
    "test:sanitizer": "npm --prefix backend run test:sanitizer",
    "test:notifications": "npm --prefix backend run test:notifications",
    "test:e2e-ai": "node test_ai_task_parser.js",
