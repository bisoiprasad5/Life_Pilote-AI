# LifePilot AI Service Configuration
PORT=8000
HOST=0.0.0.0

# LLM Provider: local, openai, gemini, anthropic
# When set to 'local', it runs fully offline with zero API keys required
LLM_PROVIDER=local

# Optional Cloud Provider API Keys:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
